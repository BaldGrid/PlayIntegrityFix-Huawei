@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion

:: ============================================================
:: 华为解决谷歌认证 
:: 作者：小白叶114514 修改版
:: 版本：2.0
:: ============================================================

set "SCRIPT_DIR=%~dp0"
set "TOOLS_DIR=%SCRIPT_DIR%tools"
set "LOG_FILE=%TEMP%\huawei_google_fix.log"
set "ADB_PATH="
set "ADB_FOUND=0"
set "DEVICE_CONNECTED=0"

:: 初始化日志
echo ======================================== > "%LOG_FILE%"
echo 脚本启动时间: %date% %time% >> "%LOG_FILE%"
echo ======================================== >> "%LOG_FILE%"

:CLEAR_ENV
cls
color 1F

:: ============================================================
:: 肥美的标题栏
:: ============================================================
echo ╔══════════════════════════════════════════════════════════╗
echo ║                                                          ║
echo ║          华 为 解 决 谷 歌 认 证 工 具 v2.0             ║
echo ║                                                          ║
echo ╚══════════════════════════════════════════════════════════╝
echo.
echo [信息] 正在初始化环境，请稍候...
call :LOADING_ANIMATION 3

:: ============================================================
:: 第一步：检测 ADB（增强版）
:: ============================================================
echo [检测] 正在扫描 ADB 工具...
call :CHECK_ADB

if "%ADB_FOUND%"=="0" (
    call :SHOW_ERROR "未检测到adb程序，请关闭安全卫士后重新下载并解压！按任意键退出！"
    echo [日志] ADB 检测失败，脚本退出 >> "%LOG_FILE%"
    pause >nul
    exit /b 1
)

echo [成功] ADB 工具已就绪: %ADB_PATH% >> "%LOG_FILE%"
echo.
echo [信息] 环境检测通过，正在加载主菜单...
call :LOADING_ANIMATION 2
goto MENU

:: ============================================================
:: 主菜单
:: ============================================================
:MENU
cls
color 1F
echo ╔══════════════════════════════════════════════════════════╗
echo ║                                                          ║
echo ║          华 为 解 决 谷 歌 认 证 工 具 v2.0             ║
echo ║                                                          ║
echo ╚══════════════════════════════════════════════════════════╝
echo.
echo ╔══════════════════════════════════════════════════════════╗
echo ║  重要提示：                                              ║
echo ║  ● 请务必开启USB调试，并使用原装数据线                   ║
echo ║  ● 插上电脑之后请务必选择传输文件模式                    ║
echo ║  ● 本工具仅支持华为鸿蒙4.2及以下系统                    ║
echo ║  ● 鸿蒙5及以上系统请安装"出境易"                        ║
echo ║  ● 原作者：哔哩哔哩UP主 小白叶114514                    ║
echo ║  ● 未经允许禁止搬运                                      ║
echo ╚══════════════════════════════════════════════════════════╝
echo.
echo ┌──────────────────────────────────────────────────────────┐
echo │  [1] 解决谷歌弹窗认证              [推荐]              │
echo │  [2] 检测adb端口是否连接                               │
echo │  [3] 安装adb ^& fastboot 驱动                         │
echo │  [4] 查看详细日志                      [调试]           │
echo │  [5] 退出脚本                                         │
echo └──────────────────────────────────────────────────────────┘
echo.
set /p choice=请输入您的选择(只输入数字即可): 

if "%choice%"=="1" goto OPTION1
if "%choice%"=="2" goto OPTION2
if "%choice%"=="3" goto OPTION3
if "%choice%"=="4" goto SHOW_LOG
if "%choice%"=="5" goto EXIT_SCRIPT
echo.
color 4F
echo [错误] 无效的选择，请重新输入！
echo [日志] 用户输入无效选择: %choice% >> "%LOG_FILE%"
timeout /t 2 >nul
color 1F
goto MENU

:: ============================================================
:: 功能1：解决谷歌弹窗认证（增强版）
:: ============================================================
:OPTION1
cls
color 1E
echo ╔══════════════════════════════════════════════════════════╗
echo ║             正在执行谷歌弹窗认证修复...                   ║
echo ╚══════════════════════════════════════════════════════════╝
echo.
echo [信息] 开始时间: %date% %time% >> "%LOG_FILE%"

:: 检测设备连接（增强版）
echo [检测] 正在扫描已连接的安卓设备...
%ADB_PATH% devices > "%TEMP%\adb_devices.txt" 2>&1
set "DEVICE_COUNT=0"
for /f "tokens=1" %%i in ('findstr /r "[0-9A-Fa-f]" "%TEMP%\adb_devices.txt" 2^>nul') do set /a DEVICE_COUNT+=1

if %DEVICE_COUNT% lss 1 (
    echo.
    color 4F
    echo ╔══════════════════════════════════════════════════════════╗
    echo ║  ✗ 错误：未检测到已连接的设备！                         ║
    echo ║  请检查：                                              ║
    echo ║  1. USB调试是否已开启                                  ║
    echo ║  2. 传输文件模式是否已选择                             ║
    echo ║  3. 数据线是否连接牢固                                 ║
    echo ╚══════════════════════════════════════════════════════════╝
    echo.
    echo [日志] 未检测到任何设备 >> "%LOG_FILE%"
    pause >nul
    color 1F
    goto MENU
)

echo [成功] 检测到 %DEVICE_COUNT% 个设备 >> "%LOG_FILE%"

:: 显示设备信息
echo.
echo [设备信息]
echo ┌──────────────────────────────────────────────────────────┐
%ADB_PATH% devices
echo └──────────────────────────────────────────────────────────┘
echo.

:: 执行修复操作
echo [执行] 正在清除谷歌服务数据...
call :EXECUTE_ADB "shell pm clear com.google.android.gms" "清除 Google Play 服务"
call :EXECUTE_ADB "shell pm clear com.google.android.gsf" "清除 谷歌服务框架"
call :EXECUTE_ADB "shell pm clear com.android.vending" "清除 Google Play 商店"

echo [执行] 正在停用谷歌服务框架...
%ADB_PATH% shell pm disable-user --user 0 com.google.android.gsf >> "%LOG_FILE%" 2>&1
if %errorlevel% equ 0 (
    echo [成功] 谷歌服务框架已停用 >> "%LOG_FILE%"
) else (
    echo [警告] 停用操作可能失败，请检查权限 >> "%LOG_FILE%"
)

:: 最终验证
echo.
echo [验证] 正在验证修复结果...
timeout /t 2 >nul

echo.
color 2F
echo ╔══════════════════════════════════════════════════════════╗
echo ║                                                          ║
echo ║     ✿ 恭喜，已成功解决弹窗认证！ ✿                     ║
echo ║                                                          ║
echo ║  如果问题依然存在，请尝试：                              ║
echo ║  1. 重启手机后再次运行本工具                            ║
echo ║  2. 检查网络连接（需科学上网）                          ║
echo ║  3. 查看日志文件获取更多信息                            ║
echo ║                                                          ║
echo ╚══════════════════════════════════════════════════════════╝
echo.
echo [日志] 修复流程完成 >> "%LOG_FILE%"
pause >nul
color 1F
goto MENU

:: ============================================================
:: 功能2：检测adb端口是否连接（增强版）
:: ============================================================
:OPTION2
cls
color 1E
echo ╔══════════════════════════════════════════════════════════╗
echo ║                  ADB 连接状态检测                        ║
echo ╚══════════════════════════════════════════════════════════╝
echo.
echo [信息] 正在执行 adb devices 命令...
echo.
echo ┌──────────────────────────────────────────────────────────┐
%ADB_PATH% devices
echo └──────────────────────────────────────────────────────────┘
echo.
echo ╔══════════════════════════════════════════════════════════╗
echo ║  检测结果说明：                                          ║
echo ║  ● 如果什么都没有显示 → 数据线连接不牢固或USB调试未开  ║
echo ║  ● 显示 xxxxxxx devices → 连接成功 ✓                   ║
echo ║  ● 显示 xxxxxxx unauthorized → 未授权，请确认USB调试   ║
echo ║  ● 显示 xxxxxxx offline → 设备离线，检查传输文件模式   ║
echo ║  ● 列出多个设备 → 请拔出其他设备或退出安卓模拟器      ║
echo ╚══════════════════════════════════════════════════════════╝
echo.
echo [日志] 执行 adb devices 检测 >> "%LOG_FILE%"
pause >nul
color 1F
goto MENU

:: ============================================================
:: 功能3：安装驱动（简化版）
:: ============================================================
:OPTION3
cls
color 1E
echo ╔══════════════════════════════════════════════════════════╗
echo ║                   驱动安装程序                           ║
echo ╚══════════════════════════════════════════════════════════╝
echo.
if not exist "%TOOLS_DIR%\d.exe" (
    color 4F
    echo ╔══════════════════════════════════════════════════════════╗
    echo ║  ✗ 错误：未找到 tools\d.exe 文件！                     ║
    echo ║  请确保以下文件存在：                                   ║
    echo ║  %TOOLS_DIR%\d.exe                                      ║
    echo ╚══════════════════════════════════════════════════════════╝
    echo.
    echo [日志] 错误：d.exe 文件不存在 >> "%LOG_FILE%"
    pause >nul
    color 1F
    goto MENU
)

echo [执行] 正在启动驱动安装程序...
echo [信息] 文件路径: %TOOLS_DIR%\d.exe >> "%LOG_FILE%"

:: 检查是否以管理员权限运行
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo [警告] 当前未以管理员权限运行，部分驱动可能安装失败！
    echo.
    echo 建议：右键脚本选择"以管理员身份运行"重试
    echo.
)

start "" "%TOOLS_DIR%\d.exe"
if %errorlevel% equ 0 (
    echo [成功] 驱动安装程序已启动
    echo.
    echo ╔══════════════════════════════════════════════════════════╗
    echo ║  ✓ 驱动安装程序已启动                                   ║
    echo ║  请按照驱动安装界面提示完成安装                         ║
    echo ║  安装完成后返回本窗口，按任意键继续                     ║
    echo ╚══════════════════════════════════════════════════════════╝
    echo [日志] 驱动安装程序启动成功 >> "%LOG_FILE%"
) else (
    color 4F
    echo [错误] 驱动安装程序启动失败！
    echo [日志] 驱动安装程序启动失败 >> "%LOG_FILE%"
)
echo.
pause >nul
color 1F
goto MENU

:: ============================================================
:: 功能4：查看日志
:: ============================================================
:SHOW_LOG
cls
color 1E
echo ╔══════════════════════════════════════════════════════════╗
echo ║                   详细日志查看                           ║
echo ╚══════════════════════════════════════════════════════════╝
echo.
if not exist "%LOG_FILE%" (
    echo [信息] 暂无日志记录
) else (
    echo ┌──────────────────────────────────────────────────────────┐
    type "%LOG_FILE%"
    echo └──────────────────────────────────────────────────────────┘
    echo.
    echo [信息] 日志文件位置: %LOG_FILE%
)
echo.
pause >nul
color 1F
goto MENU

:: ============================================================
:: 功能5：退出脚本
:: ============================================================
:EXIT_SCRIPT
cls
color 1F
echo ╔══════════════════════════════════════════════════════════╗
echo ║                                                          ║
echo ║              感谢使用华为解决谷歌认证工具                 ║
echo ║                                                          ║
echo ║              作者：小白叶114514                         ║
echo ║              再见！                                      ║
echo ║                                                          ║
echo ╚══════════════════════════════════════════════════════════╝
echo.
echo [日志] 脚本正常退出 >> "%LOG_FILE%"
timeout /t 2 >nul
exit /b 0

:: ============================================================
:: 子程序：检查 ADB
:: ============================================================
:CHECK_ADB
if exist "%TOOLS_DIR%\adb.exe" (
    set "ADB_PATH=%TOOLS_DIR%\adb.exe"
    set "ADB_FOUND=1"
    echo [检测] 在 tools 目录找到 adb.exe
    exit /b
)

where adb >nul 2>nul
if %errorlevel% equ 0 (
    set "ADB_PATH=adb"
    set "ADB_FOUND=1"
    echo [检测] 在系统环境变量找到 adb
    exit /b
)

set "ADB_FOUND=0"
echo [检测] 未找到任何 adb 工具
exit /b

:: ============================================================
:: 子程序：显示错误（红色，重复3次）
:: ============================================================
:SHOW_ERROR
for /l %%i in (1,1,3) do (
    echo.
    color 4F
    echo ╔══════════════════════════════════════════════════════════╗
    echo ║  ✗ %~1
    echo ╚══════════════════════════════════════════════════════════╝
    color 1F
    timeout /t 1 >nul
)
exit /b

:: ============================================================
:: 子程序：执行 ADB 命令
:: ============================================================
:EXECUTE_ADB
echo [执行] %~2 ...
%ADB_PATH% %~1 >> "%LOG_FILE%" 2>&1
if %errorlevel% equ 0 (
    echo [成功] %~2 完成 >> "%LOG_FILE%"
) else (
    echo [警告] %~2 可能失败，错误代码: %errorlevel% >> "%LOG_FILE%"
)
exit /b

:: ============================================================
:: 子程序：加载动画
:: ============================================================
:LOADING_ANIMATION
set "DOTS=."
for /l %%i in (1,1,%1) do (
    set /p "=   " <nul
    for /l %%j in (1,1,5) do (
        set /p "=." <nul
        timeout /t 0.2 >nul
    )
    echo.
)
exit /b